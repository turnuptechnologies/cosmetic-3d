# Copy to .env (never commit real values)

# Payload CMS API
NEXT_PUBLIC_API_URI='https://backend.cosmeticchemist.com/api'

# Contact-form email (nodemailer / Gmail)
EMAIL_USER=
EMAIL_PASS=

# Google reCAPTCHA v2 checkbox (https://www.google.com/recaptcha/admin)
# Site key is public and is inlined at build time; the secret key is server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key
